# onju-asr-whisper — faster-whisper (CTranslate2) ASR container
#
# CPU-optimised: CTranslate2 uses INT8 quantisation + AVX-512 on Zen 5 CPUs
# (lunarBeacon Strix Halo). Same /transcribe contract as parakeet.
#
# Note: whisper.cpp Vulkan was attempted but hits a GGML Vulkan crash on
# GFX1151 (Strix Halo). faster-whisper on Zen 5 with AVX-512 + INT8 is
# competitive and avoids the Vulkan dependency.
#
# Run:
#   podman run -d --restart unless-stopped \
#     -p 8101:8101 -v whisper-models:/models \
#     -e WHISPER_MODEL=base.en \
#     onju-asr-whisper
#
# Smoke test:
#   curl http://localhost:8101/health

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    python3 python3-pip \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages \
    faster-whisper==1.2.1 \
    fastapi==0.139.0 \
    uvicorn==0.49.0 \
    python-multipart==0.0.32

WORKDIR /app
COPY whisper_server.py /app/whisper_server.py

VOLUME ["/models"]

ENV WHISPER_MODEL=base.en
ENV WHISPER_MODEL_DIR=/models
# compute_type: int8 for fastest CPU, int8_float16 for mixed, float16 for accuracy
ENV WHISPER_COMPUTE_TYPE=int8

EXPOSE 8101

CMD ["python3", "whisper_server.py"]
