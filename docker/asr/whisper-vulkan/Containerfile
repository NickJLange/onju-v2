# whisper-vulkan — whisper.cpp with GGML Vulkan backend
#
# GPU passthrough (rootless, lunarBeacon AMD RADV):
#   podman run -d --restart unless-stopped \
#     --device /dev/dri --group-add keep-groups \
#     -p 8101:8101 -v whisper-models:/models \
#     -e WHISPER_MODEL=base.en \
#     onju-whisper-vulkan
#
# Smoke test (run inside container after start):
#   podman exec <ctr> vulkaninfo --summary
#   podman logs <ctr>   # check for "Vulkan" + AMD device in whisper.cpp init

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# ── Build + runtime deps ────────────────────────────────────────────────────
# libvulkan-dev + glslc = needed to compile whisper.cpp Vulkan shaders
# mesa-vulkan-drivers = RADV ICD (libvulkan_radeon.so) for runtime
# vulkan-tools = vulkaninfo for smoke testing inside the container
RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-dev \
    cmake build-essential ninja-build git \
    libvulkan-dev \
    glslc \
    libvulkan1 \
    mesa-vulkan-drivers \
    vulkan-tools \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# ── Python deps ─────────────────────────────────────────────────────────────
# fastapi/uvicorn first (no heavy build)
RUN pip3 install --break-system-packages fastapi uvicorn python-multipart

# Build pywhispercpp with Vulkan support.
# CMAKE_ARGS is read by pywhispercpp's setup.py and passed to the cmake build.
RUN CMAKE_ARGS="-DGGML_VULKAN=1" \
    pip3 install --break-system-packages --no-binary pywhispercpp pywhispercpp

# ── App ─────────────────────────────────────────────────────────────────────
WORKDIR /app
COPY whisper_server.py /app/whisper_server.py

# Model cache — mount a named volume here to avoid re-downloading
VOLUME ["/models"]

ENV WHISPER_MODEL=base.en
ENV WHISPER_MODEL_DIR=/models

EXPOSE 8101

CMD ["python3", "whisper_server.py"]
